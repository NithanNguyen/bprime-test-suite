# B' test suite - shared settings. This is the only file you should need to edit.

# Images (pin by digest later if you want bit-identical runs on several machines;
# `./bprime.sh pull` records the digests in the log folder).
ISAAC_IMAGE="nvcr.io/nvidia/isaac-sim:4.1.0"
FOXY_IMAGE="osrf/ros:foxy-desktop"

# Isolated DDS domain: ROS 2 nodes running on the host (e.g. Foxy sourced in ~/.bashrc)
# cannot be mistaken for the Foxy container during the tests.
BPRIME_DOMAIN_ID=42

ISAAC_CONTAINER="bprime-isaac"
FOXY_CONTAINER="bprime-foxy"

# Host folders. One cache folder per Isaac Sim version, so the 4.1 shader cache never
# mixes with another installed version (e.g. Isaac Sim 5.1 on the PC).
ISAAC_CACHE_ROOT="${ISAAC_CACHE_ROOT:-${HOME}/docker/isaac-sim-4.1}"
BPRIME_LOG_DIR="${BPRIME_LOG_DIR:-${HOME}/bprime_logs}"
