<?xml version="1.0" encoding="UTF-8" ?>
<!--
  UDP-only Fast DDS profile.
  Based on the profile given in the Isaac Sim 4.1 docs ("Enabling the ROS Bridge Extension"):
  https://docs.isaacsim.omniverse.nvidia.com/4.1.0/installation/install_ros.html
  Purpose: disable the shared-memory transport so the Isaac Sim container and the
  ROS 2 Foxy container exchange data over UDP only.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>UdpTransport</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_transport_profile" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>UdpTransport</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
